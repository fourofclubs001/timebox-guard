<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="56dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#16161A"
            android:gravity="center"
            android:paddingBottom="20dp"
            android:text="How long, and why?" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Minutes"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#16161A"
            android:paddingBottom="4dp" />

        <NumberPicker
            android:id="@+id/pickerMinutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:theme="@android:style/Theme.DeviceDefault.Light" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reason"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#16161A"
            android:paddingTop="20dp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/editReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:textColor="#16161A"
            android:textColorHint="#9A9AA2"
            android:textSize="18sp"
            android:hint="Why are you opening this app?" />

        <Button
            android:id="@+id/buttonStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Start session" />

        <Button
            android:id="@+id/buttonClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Close app instead" />

    </LinearLayout>
</ScrollView>
