<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/rowHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="56dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/textLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/textPackage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#888888" />
        </LinearLayout>

        <Switch
            android:id="@+id/switchGuard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false" />

    </LinearLayout>

    <!-- Only shown while this app is guarded (switchGuard on). Its own
         darker card, with a tap-to-collapse header, so it doesn't have to
         sit open for every guarded app at once. -->
    <LinearLayout
        android:id="@+id/sectionExcuses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_excuse_section"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/rowExcuseToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="32dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#444444"
                android:text="Reason settings" />

            <TextView
                android:id="@+id/textExcuseToggleArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#444444"
                android:text="▸" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/excuseBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="40dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:textColor="#444444"
                    android:text="Restrict to a list of reasons" />

                <Switch
                    android:id="@+id/switchRestrictReasons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/excuseListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Only shown while switchRestrictReasons is on. -->
            <LinearLayout
                android:id="@+id/rowAddExcuse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="4dp"
                android:visibility="gone">

                <!-- Collapsed state: just this button. Tapping it swaps in
                     editNewExcuse + buttonConfirmExcuse below. -->
                <Button
                    android:id="@+id/buttonAddExcuse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Add reason" />

                <EditText
                    android:id="@+id/editNewExcuse"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Add a reason"
                    android:textSize="14sp"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/buttonConfirmExcuse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
